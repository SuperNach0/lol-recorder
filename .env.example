# Token du bot (portail développeur Discord > ton application > Bot > Reset Token)
DISCORD_TOKEN=


# Optionnel : par défaut, le bot suit le propriétaire de l'application Discord
DISCORD_OWNER_ID=
# Optionnel : chemin du lockfile si LoL n'est pas installé dans C:\Riot Games
# LOL_LOCKFILE=D:\Riot Games\League of Legends\lockfile
# Optionnel : dossier des enregistrements
# SESSIONS_DIR=sessions
